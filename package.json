{
  "name": "pal",
  "version": "0.0.0",
  "private": true,
  "description": "A durable, workspace-first personal AI application",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "node --watch src/main.ts --port 7338",
    "dev:web": "vite",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && vite build && esbuild src/main.ts --bundle --splitting --format=esm --platform=node --target=node24 --packages=external --sourcemap --outdir=dist",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest run",
    "test:feasibility": "vitest run --config vitest.feasibility.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "pnpm build && node dist/main.js",
    "serve": "node dist/main.js",
    "postinstall": "node -e \"for (const arch of ['arm64', 'x64']) try { require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-' + arch + '/spawn-helper', 0o755) } catch {}\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@ff-labs/fff-node": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "jose": "6.2.12",
    "node-pty": "1.1.0",
    "playwright-core": "1.59.1",
    "sirv": "3.0.2",
    "typebox": "1.3.27",
    "undici": "7.30.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "markdown-it": "15.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
